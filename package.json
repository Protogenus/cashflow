{
  "dependencies": {
    "@xyflow/react": "^12.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.1.0",
    "zustand": "^5.0.5"
  },
  "description": "Node-based personal cash-flow planner. Local-only, privacy-first \u2014 no backend, no analytics, no network calls with user data.",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "tailwindcss": "^4.1.11",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^3.2.4",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0"
  },
  "name": "cashflow-planner",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:web": "tsc -b && vite build",
    "preview": "electron-vite preview",
    "dist": "npm run build && electron-builder --win --x64 --publish never",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "version": "0.1.0",
  "main": "out/main/index.js",
  "build": {
    "appId": "com.cleversignal.cashflow",
    "productName": "Cashflow",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "zip"
      ]
    },
    "npmRebuild": false
  }
}
